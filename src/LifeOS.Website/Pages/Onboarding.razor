@page "/onboarding"

<SeoHead Title="Private Beta Onboarding"
         Description="Start with local LifeOS modules, review privacy, then connect optional providers now, later or not at all."
         CanonicalPath="/onboarding" />

<main class="page-shell">
    <section class="page-intro">
        <p class="eyebrow">PRIVATE BETA ONBOARDING</p>
        <h1>Start locally. Add providers only when they help.</h1>
        <p>
            LifeOS works without external AI or connected accounts.
            Optional integrations can be set up now, later, or declined.
        </p>
    </section>

    <section class="feature-grid">
        <article class="feature-card">
            <span class="status-pill">Step 1</span>
            <h2>Choose core modules</h2>
            <p>Work, household, money, life and project data remain local by default.</p>
        </article>
        <article class="feature-card">
            <span class="status-pill">Step 2</span>
            <h2>Review privacy</h2>
            <p>Grant sensitive category permissions independently and change them anytime.</p>
        </article>
        <article class="feature-card">
            <span class="status-pill">Step 3</span>
            <h2>Optional providers</h2>
            <p>Connect read-only services now, choose later, or decline without losing core value.</p>
        </article>
    </section>
</main>
