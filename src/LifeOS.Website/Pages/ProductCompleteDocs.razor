@page "/docs/product-complete"

<PageTitle>Product documentation - Life Control OS</PageTitle>

<main class="page-shell">
    <section class="page-intro">
        <p class="eyebrow">DOCUMENTATION HUB</p>
        <h1>One calm place for product help and release proof.</h1>
        <p>
            Long-form guidance lives here so the desktop and mobile apps can keep
            their help concise and task-focused.
        </p>
    </section>

    <section class="feature-grid">
        <article class="feature-card">
            <span class="status-pill">Public</span>
            <h2>Start and configure</h2>
            <p>Core setup, privacy choices, provider permissions and disconnected operation.</p>
            <a href="/guides">Open guides</a>
        </article>
        <article class="feature-card">
            <span class="status-pill">Release proof</span>
            <h2>Versions and screenshots</h2>
            <p>Release notes, roadmap state and screenshot evidence without private handoff notes.</p>
            <a href="/releases">Review releases</a>
        </article>
        <article class="feature-card">
            <span class="status-pill">Safety</span>
            <h2>Review-first boundaries</h2>
            <p>How imports, suggestions and scheduled actions remain under explicit user control.</p>
            <a href="/safety">Read safety principles</a>
        </article>
    </section>

    <section class="content-panel">
        <h2>Copy boundary</h2>
        <p>
            Public pages describe real product behaviour and beta status. Internal
            paths, account details, private prompts and development handoff notes
            are excluded.
        </p>
    </section>
</main>
