@page "/roadmap"
<SeoHead Title="Roadmap"
         Description="Completed, current and planned LifeOS product tracks."
         CanonicalPath="/roadmap" />
<PageIntro Eyebrow="Roadmap"
           Title="Private beta first. Public release only after evidence and approval."
           Summary="The sequence preserves product boundaries and makes current, historical and planned state explicit." />
<section class="page-shell section">
  <div class="roadmap-list">
    <article class="complete">
      <span>COMPLETE</span>
      <div><small>Groups 1–111</small><h2>Core product lanes</h2><p>Desktop, Full Mobile, Companion, integrations, intelligence and control-plane foundations are complete through v25.</p></div>
    </article>
    <article class="current">
      <span>CURRENT</span>
      <div><small>Groups 112–116</small><h2>v26 Website Packaging and Onboarding</h2><p>Public pages, factual case-study packaging, onboarding and distribution preparation.</p><a href="/onboarding">View onboarding →</a></div>
    </article>
    <article>
      <span>NEXT</span>
      <div><small>Groups 117–120</small><h2>v27 Product-Complete Release Candidate</h2><p>Cross-product regression, accessibility, security, final evidence and explicit owner approval.</p></div>
    </article>
    <article>
      <span>AFTER BETA</span>
      <div><small>Public rollout</small><h2>Feedback before launch</h2><p>Store submission, public deployment and broader rollout follow private-beta feedback and a separate release decision.</p></div>
    </article>
  </div>
</section>
